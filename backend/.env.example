# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/crypto-haven

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Frontend URL(s) for CORS — comma-separated for multiple dev ports
CLIENT_URL=http://localhost:8080,http://localhost:5173

# Initial admin account (created on first server start)
ADMIN_EMAIL=admin@cryptohaven.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FNAME=Admin
ADMIN_LNAME=User
